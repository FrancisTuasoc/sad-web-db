DATABASE_URL=
JWT_SECRET=
PORT=
NODE_ENV=
CORS_ORIGINS=https://sad-web-db-frontend.vercel.app,http://localhost:5000,http://127.0.0.1:5000,http://localhost:5500,http://127.0.0.1:5500
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Dedicated API key for password reset emails (optional, defaults to BREVO_API_KEY)
